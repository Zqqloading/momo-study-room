# 全部变量值留空：留空即走默认值，服务自动退回离线假实现。
# 复制成 .env 后按需只填要用的服务。

# ---- 运行模式 ----
# auto：有配置就真实调用，缺的退回离线假实现；real：必配服务缺一个就拒绝启动；fake：全离线
PROVIDER_MODE=
# 单次外部 HTTP 请求超时（秒），默认 60
HTTP_TIMEOUT_SECONDS=

# ---- 目录 ----
# 内容真相目录（concepts.yaml + seeds/question_bank.json 所在目录）；默认项目根
CONTENT_DIR=
# 运行时数据目录（SQLite、音频缓存）；默认 data
DATA_DIR=
# SQLite 路径；默认 $DATA_DIR/app.db
DB_PATH=

# ---- 小米 MiMo：LLM 与 ASR 共用一把 key ----
MIMO_API_KEY=

# ---- LLM ----
# 默认 mimo
LLM_KIND=
# 例如 https://api.xiaomimimo.com/v1
LLM_BASE_URL=
LLM_API_KEY=
# 例如 mimo-v2.6-flash
LLM_MODEL=
# api_key 或 bearer
LLM_AUTH=
# 1 发送 temperature；thinking 模式下 MiMo 不接受，默认 0
LLM_SEND_TEMPERATURE=

# ---- ASR：MiMo ASR ----
# 默认 mimo_asr
ASR_KIND=
# 例如 https://api.xiaomimimo.com/v1
ASR_BASE_URL=
ASR_API_KEY=
# 例如 mimo-v2.5-asr
ASR_MODEL_NAME=
# 默认 zh
ASR_LANGUAGE=

# ---- TTS ----
# 默认 breeze；deepseek 表示用 DeepSeek 兼容接口
TTS_KIND=
# 例如 https://api.breeze.blue
TTS_BASE_URL=
# BREEZE_API_KEY 与 TTS_API_KEY 二选一；都留空则 TTS 视为未配置
BREEZE_API_KEY=
TTS_API_KEY=
# 例如 breeze-tts-2
TTS_MODEL=
# 从 Breeze 控制台复制的 voice_id
TTS_VOICE=
# 默认 zh
TTS_LANGUAGE=
# 例如 mp3_24000_128
TTS_OUTPUT_FORMAT=

# ---- 评分：DeepSeek Flash ----
# 例如 https://api.deepseek.com/v1
SCORER_BASE_URL=
SCORER_API_KEY=
# 例如 deepseek-chat
SCORER_MODEL=
# 1 要求 JSON 输出
SCORER_JSON_MODE=

# ---- Agent harness：有界工具回合 ----
# off 走程序路径；on 自由对话与教学/澄清走 agent 循环
AGENT_HARNESS=
# 留空默认复用 SCORER_*；填了才切到别的 OpenAI 兼容端点
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=

# ---- 情绪与用户记忆 ----
# 情绪按 (user_id, role) 存；记忆按 user_id 存
USER_ID=
USER_ROLE=
# off：不更新情绪、不发 emotion 事件、前端保持 neutral
EMOTION_ENABLED=
# off：不提炼、不读、不拼开场
MEMORY_ENABLED=

# ---- 管理后台任务执行器 ----
# 1 打开长任务后台执行；留空时非 fake 模式自动打开，fake 模式默认关闭
ADMIN_TASK_RUNNER=

# ---- 检索 embedding：阿里 DashScope ----
# 例如 https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 例如 text-embedding-v4
EMBEDDING_MODEL=
# 向量维度，默认 1024
EMBEDDING_DIM=
# 关键词无命中且最高余弦低于此值时视为“材料里没有”，默认 0.35
RETRIEVAL_MIN_COSINE=

# ---- 联网搜索 ----
# 默认 tavily；off 关闭联网
SEARCH_KIND=
TAVILY_API_KEY=
# 默认 https://api.tavily.com
SEARCH_BASE_URL=
# 单次返回条数，默认 5
SEARCH_MAX_RESULTS=
# 单次搜索超时（秒），默认 8
SEARCH_TIMEOUT_SECONDS=
